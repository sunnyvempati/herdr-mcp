{
  "name": "herdr-mcp",
  "version": "0.1.0",
  "description": "MCP server for monitoring and controlling AI coding agents in Herdr terminal workspaces",
  "type": "module",
  "bin": {
    "herdr-mcp": "./build/index.js"
  },
  "main": "./build/index.js",
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "node --test build/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/herdrdev/herdr-mcp.git"
  },
  "keywords": [
    "mcp",
    "herdr",
    "ai-agents",
    "terminal",
    "claude",
    "cursor",
    "grok"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
