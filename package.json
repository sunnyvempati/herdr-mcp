{
  "name": "herdr-mcp",
  "version": "0.1.0",
  "description": "MCP server for monitoring and controlling AI coding agents in Herdr terminal workspaces",
  "type": "module",
  "bin": {
    "herdr-mcp": "./build/index.js"
  },
  "main": "./build/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && chmod 755 build/index.js",
    "typecheck": "tsc --noEmit",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "node --test --test-timeout=20000 build/test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "render:assets": "node scripts/render-assets.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sunnyvempati/herdr-mcp.git"
  },
  "homepage": "https://github.com/sunnyvempati/herdr-mcp#readme",
  "bugs": {
    "url": "https://github.com/sunnyvempati/herdr-mcp/issues"
  },
  "keywords": [
    "mcp",
    "herdr",
    "ai-agents",
    "terminal",
    "claude",
    "cursor",
    "grok"
  ],
  "author": "sunnyvempati",
  "license": "MIT",
  "files": [
    "build/*.js",
    "build/*.js.map",
    "build/*.d.ts",
    "build/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
