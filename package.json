{
  "name": "herdr-mcp",
  "version": "0.1.0",
  "description": "MCP server for monitoring and controlling AI coding agents in Herdr terminal workspaces",
  "type": "module",
  "bin": {
    "herdr-mcp": "./build/index.js"
  },
  "main": "./build/index.js",
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "node --test build/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sunnyvempati/herdr-mcp.git"
  },
  "homepage": "https://github.com/sunnyvempati/herdr-mcp#readme",
  "bugs": {
    "url": "https://github.com/sunnyvempati/herdr-mcp/issues"
  },
  "keywords": [
    "mcp",
    "herdr",
    "ai-agents",
    "terminal",
    "claude",
    "cursor",
    "grok"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "build/index.js",
    "build/index.js.map",
    "build/index.d.ts",
    "build/index.d.ts.map",
    "build/herdr.js",
    "build/herdr.js.map",
    "build/herdr.d.ts",
    "build/herdr.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.0.0"
  }
}
